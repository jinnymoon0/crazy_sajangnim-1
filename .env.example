# PostHog browser analytics and session replay.
#
# Both are public by design: the project token identifies where events
# go, and cannot read anything back. The personal API key used by the
# admin is deliberately NOT here — it never belongs in this app.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
